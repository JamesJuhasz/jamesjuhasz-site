{
  "name": "jamesjuhasz-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "import:dry": "tsx scripts/import-from-export.ts --dry --limit=3",
    "import:full": "tsx scripts/import-from-export.ts",
    "backfill:covers": "tsx scripts/backfill-covers.ts",
    "press:fetch": "tsx scripts/fetch-press.ts",
    "results:fetch": "tsx scripts/fetch-results.ts",
    "results:verify": "tsx --env-file=.env.local scripts/verify-results.ts",
    "ws:fetch": "tsx scripts/fetch-world-sailing.ts",
    "ws:enrich": "tsx --env-file=.env.local scripts/enrich-world-sailing.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.4",
    "@portabletext/react": "^6.0.3",
    "@sanity/block-tools": "^3.70.0",
    "@sanity/client": "^7.22.0",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.1.1",
    "@sanity/ui": "^3.1.14",
    "@sanity/vision": "^5.23.0",
    "@vercel/og": "^0.11.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-sanity": "^12.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2",
    "sanity": "^5.23.0",
    "styled-components": "^6.4.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@sanity/block-content-to-markdown": "^1.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "^5.7.284",
    "playwright": "^1.59.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
